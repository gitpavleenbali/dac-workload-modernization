[Unit]
Description=Grid Telemetry & Dispatch HTTP Service (Legacy VM Host)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gridsvc
Group=gridsvc
WorkingDirectory=/opt/grid-telemetry-service
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=GRID_ZONE=eu-central-1
ExecStart=/usr/bin/node /opt/grid-telemetry-service/src/server.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

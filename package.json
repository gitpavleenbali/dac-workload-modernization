{
  "name": "grid-telemetry-service",
  "version": "1.0.0",
  "description": "Grid Substation Telemetry Service & Portable Docs-as-Code Architecture Translator Reference",
  "type": "module",
  "scripts": {
    "start": "node src/server.mjs",
    "test:app": "node --test test/*.test.mjs",
    "test:dac": "node --test packages/dac-translator/test/*.test.mjs",
    "test": "node --test test/*.test.mjs packages/dac-translator/test/*.test.mjs",
    "dac:extract": "node packages/dac-translator/bin/dac-translator.mjs extract",
    "dac:render": "node packages/dac-translator/bin/dac-translator.mjs render",
    "dac:verify": "node packages/dac-translator/bin/dac-translator.mjs verify",
    "dac:diff": "node packages/dac-translator/bin/dac-translator.mjs diff",
    "dac:sync-pr": "node packages/dac-translator/bin/dac-translator.mjs sync-central-pr",
    "demo:option1:baseline": "node scripts/doc-as-code/option1-demo.mjs baseline",
    "demo:option1:prepare": "node scripts/doc-as-code/option1-demo.mjs prepare",
    "demo:option1:render": "node scripts/doc-as-code/option1-demo.mjs render",
    "demo:option1:clean": "node scripts/doc-as-code/option1-demo.mjs clean",
    "demo:option2a:prepare": "node scripts/doc-as-code/option2a-demo.mjs prepare",
    "demo:option2a:check": "node scripts/doc-as-code/option2a-demo.mjs check",
    "demo:option2a:clean": "node scripts/doc-as-code/option2a-demo.mjs clean",
    "demo:option2b:evidence": "node scripts/doc-as-code/option2b-demo.mjs evidence",
    "demo:option2b:clean": "node scripts/doc-as-code/option2b-demo.mjs clean"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
